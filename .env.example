# Note: NEXT_PUBLIC_* variables are exposed to the browser. Keep secrets server-side only.

# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase storage buckets
NEXT_PUBLIC_PROJECT_IMAGES_BUCKET=project-images
NEXT_PUBLIC_INSIGHT_IMAGES_BUCKET=insight-images

# Public site configuration
NEXT_PUBLIC_SITE_URL=https://eryawanagung.my.id
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com
# Enable admin edit shortcuts on public detail pages only when needed.
NEXT_PUBLIC_ENABLE_ADMIN_SHORTCUTS=false

# Server-side secrets
OPENAI_API_KEY=
# CV access request notifications (server-side only)
CV_ACCESS_ADMIN_NOTIFY_EMAIL=
CV_ACCESS_NOTIFY_WEBHOOK_URL=
# Email delivery uses Resend when configured; submissions still succeed if delivery fails.
RESEND_API_KEY=
CV_ACCESS_NOTIFY_EMAIL_FROM=Portfolio <notifications@example.com>

# Desktop push notifications for new project inquiries (server-side only)
# Never prefix these variables with NEXT_PUBLIC_ or expose the private/service-role keys.
SUPABASE_SERVICE_ROLE_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:eryawanagungtrimuda@gmail.com
